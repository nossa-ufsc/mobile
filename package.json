{
  "name": "nossa-ufsc",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "dev": "bun run start",
    "build:ios:production": "eas build -p ios --profile production --local",
    "build:ios:production:submit": "bash scripts/ios-build.sh production --submit",
    "build:ios:preview": "bash scripts/ios-build.sh preview",
    "build:ios:development": "eas build -p ios --profile development",
    "submit:ios": "bash scripts/ios-submit.sh",
    "build:android:production": "eas build -p android --profile production --local",
    "build:android:production:submit": "bash scripts/android-build.sh production --submit",
    "build:android:preview": "bash scripts/android-build.sh preview",
    "submit:android": "bash scripts/android-submit.sh",
    "run:android": "expo prebuild && bun android",
    "run:ios": "expo prebuild && bun ios",
    "prepare": "husky"
  },
  "dependencies": {
    "@bacons/apple-targets": "^3.0.2",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.1.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-menu/menu": "^1.2.3",
    "@react-native-picker/picker": "2.11.4",
    "@rn-primitives/slot": "^1.1.0",
    "@roninoss/icons": "^0.0.4",
    "@supabase/supabase-js": "2.49.9-next.2",
    "@tanstack/react-query": "^5.74.11",
    "base64-arraybuffer": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "expo": "^57.0.0",
    "expo-application": "~57.0.0",
    "expo-auth-session": "~57.0.2",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.5",
    "expo-device": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image-picker": "~57.0.2",
    "expo-linking": "~57.0.2",
    "expo-localization": "~57.0.0",
    "expo-navigation-bar": "~57.0.1",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-store-review": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-updates": "~57.0.6",
    "expo-web-browser": "~57.0.0",
    "nativewind": "^4.2.6",
    "posthog-react-native": "^3.16.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-android-widget": "^0.21.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-ios-context-menu": "3.2.1",
    "react-native-ios-utilities": "5.2.0",
    "react-native-mmkv": "^3.2.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-uitextview": "^1.1.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0",
    "tailwind-merge": "^2.2.1",
    "zeego": "^3.0.6",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/react": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "eslint-config-universe": "^12.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "eslintConfig": {
    "extends": "universe/native",
    "root": true,
    "rules": {
      "import/order": "off"
    }
  },
  "overrides": {
    "@expo/vector-icons": "$@expo/vector-icons"
  },
  "private": true,
  "patchedDependencies": {
    "react-native-ios-utilities@5.2.0": "patches/react-native-ios-utilities@5.2.0.patch"
  },
  "packageManager": "pnpm@10.31.0+sha512.e3927388bfaa8078ceb79b748ffc1e8274e84d75163e67bc22e06c0d3aed43dd153151cbf11d7f8301ff4acb98c68bdc5cadf6989532801ffafe3b3e4a63c268"
}
